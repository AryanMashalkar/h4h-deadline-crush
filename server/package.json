{
  "name": "deadline-crush-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker/main.js",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "loadtest": "tsx scripts/loadtest.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/s3-request-presigner": "^3.1168.0",
    "@fastify/cors": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.8",
    "file-type": "^21.3.4",
    "ipaddr.js": "^2.5.0",
    "jose": "^5.10.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "undici": "^7.30.2",
    "yauzl": "^3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
